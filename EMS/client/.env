# ─────────────────────────────────────────────────────────────────
# QuickEMS — Client Environment Variables Template
# Copy this file to .env and fill in your values.
# All client env vars must be prefixed with VITE_ to be exposed.
# ─────────────────────────────────────────────────────────────────

# ── API Base URL ──────────────────────────────────────────────────
# Local development:
VITE_BASE_URL=http://localhost:4000

# Production (replace with your deployed server URL):
# VITE_BASE_URL=https://your-ems-server.vercel.app
